                <script>
                    //this script gets the collapsible buttons and adds an event listener to each one.
                    //When a button is clicked, it toggles the "active" class and shows or hides the associated content.
                    var coll = document.getElementsByClassName("collapsible_button");
                    var i;

                    for (i = 0; i < coll.length; i++) {
                      coll[i].addEventListener("click", function() {
                        this.classList.toggle("active");
                        var content = this.nextElementSibling;
                        if (content.style.display === "block") {
                          content.style.display = "none";
                        } else {
                          content.style.display = "block";
                        }
                      });
                    }
